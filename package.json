{
  "name": "@transcodely/sdk",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.3.9",
  "description": "Official TypeScript/Node SDK for Transcodely — encode video to HLS, DASH and MP4 into your own S3, GCS or R2 bucket, with DRM and signed playback.",
  "license": "MIT",
  "homepage": "https://www.transcodely.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transcodely/transcodely-js.git"
  },
  "bugs": "https://github.com/transcodely/transcodely-js/issues",
  "keywords": [
    "transcodely",
    "video",
    "transcoding",
    "encoding",
    "hls",
    "dash",
    "cmaf",
    "drm",
    "widevine",
    "fairplay",
    "abr",
    "ffmpeg",
    "s3",
    "r2",
    "signed-urls",
    "video-hosting",
    "streaming",
    "connect-rpc"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && pnpm --filter transcodely build",
    "build:watch": "tsup --watch",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p packages/cli/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src packages/cli/src packages/cli/tests",
    "format": "prettier --write src",
    "prepare": "husky"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=7.0.0 <8.0.0",
      "esbuild": ">=0.28.1",
      "js-yaml": ">=4.3.2 <5.0.0",
      "postcss": ">=8.5.23 <9.0.0",
      "fast-uri": ">=3.1.6 <4.0.0"
    }
  }
}
