{
  "name": "@transcodely/sdk",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.3.24",
  "description": "Official TypeScript/Node SDK for Transcodely — encode video to HLS, DASH and MP4 into your own S3, GCS or R2 bucket, with DRM and signed playback.",
  "license": "MIT",
  "homepage": "https://www.transcodely.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transcodely/transcodely-js.git"
  },
  "bugs": "https://github.com/transcodely/transcodely-js/issues",
  "keywords": [
    "transcodely",
    "video",
    "transcoding",
    "encoding",
    "hls",
    "dash",
    "cmaf",
    "drm",
    "widevine",
    "fairplay",
    "abr",
    "ffmpeg",
    "s3",
    "r2",
    "signed-urls",
    "video-hosting",
    "streaming",
    "connect-rpc"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "transcodely-sdk": "./dist/bin/transcodely.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./upload": {
      "types": "./dist/upload/index.d.ts",
      "import": "./dist/upload/index.mjs",
      "require": "./dist/upload/index.cjs"
    },
    "./upload/server": {
      "types": "./dist/upload/server.d.ts",
      "import": "./dist/upload/server.mjs",
      "require": "./dist/upload/server.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    },
    "./react/styles.css": "./dist/react/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.bin.config.ts && tsup --config tsup.subpaths.config.ts && node scripts/subpath-dts.mjs && pnpm --filter transcodely build",
    "build:watch": "tsup --watch",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p packages/cli/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src packages/cli/src packages/cli/tests tests/react tests/package tests/browser-upload tsup.subpaths.config.ts scripts",
    "format": "prettier --write src",
    "prepare": "husky"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.3",
    "@types/react-18": "npm:@types/react@^18.3.32",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "react": "^19.3.1",
    "react-18": "npm:react@18.3.1",
    "react-dom": "^19.3.1",
    "react-dom-18": "npm:react-dom@18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=7.3.7 <8.0.0",
      "esbuild": ">=0.28.1",
      "js-yaml": ">=4.3.2 <5.0.0",
      "postcss": ">=8.5.23 <9.0.0",
      "fast-uri": ">=3.1.9 <4.0.0",
      "source-map-js": ">=1.2.2 <2.0.0",
      "brace-expansion@<2": ">=1.1.21 <2.0.0",
      "brace-expansion@>=4 <6": ">=5.0.12 <6.0.0",
      "tinypool": ">=2.1.2 <3.0.0"
    }
  }
}
